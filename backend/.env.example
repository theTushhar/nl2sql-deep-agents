NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
# Single model for the deep agent + all subagents (subagents inherit it).
LLM_MODEL=gpt-4o-mini

OPENAI_BASE_URL=https://api.openai.com/v1

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# Langfuse per-node tracing (CallbackHandler generations + task spans).
# Blocking callbacks are required: backgrounded callbacks race the
# pre-response flush and per-node spans get lost.
LANGCHAIN_CALLBACKS_BACKGROUND=false

# Langfuse trace hygiene: framework-plumbing spans (RunnableLambda,
# middleware before/after hooks, tools/model_request wrappers) are dropped
# and oversized generation payloads truncated before export. Kept: root span,
# every ChatOpenAI generation, task + subagent spans, snapshot tools, gates.
# LANGFUSE_EXPORT_NOISY_SPANS=true   # escape hatch: export everything
# LANGFUSE_SPAN_IO_MAX_CHARS=4096    # per-span I/O char cap before export

# Per-agent LLM call budgets: max model calls per task invocation, then the
# agent fails fast instead of looping. Subagents default to 3, the
# coordinator to 20 (one call per delegation step — 3 would break every
# request). Assign per stage, e.g. LLM_CALL_LIMIT_SQL_WRITER=5.
# NOTE: AGENT_LLM_CALL_LIMIT applies to the coordinator too — do NOT set it
# to 3 unless you also raise LLM_CALL_LIMIT_COORDINATOR.
# AGENT_LLM_CALL_LIMIT=3
# LLM_CALL_LIMIT_COORDINATOR=20

# Bounded execution: keeps /api/query from hanging on slow LLM stalls.
# Agent invoke aborts after AGENT_TIMEOUT_MS (surfacing kind=error);
# the HTTP layer returns 504 after REQUEST_TIMEOUT_MS (never a hung socket).
AGENT_TIMEOUT_MS=120000
AGENT_RECURSION_LIMIT=80
REQUEST_TIMEOUT_MS=150000
