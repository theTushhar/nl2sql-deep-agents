NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
# Legacy alias kept for compat; SIMPLE_MODEL is the key actually read.
OPENAI_MODEL=gpt-4o-mini
# Generic LLM selector (src/orchestration/llm-client.ts reads this; kept in sync with OPENAI_MODEL)
SIMPLE_MODEL=gpt-4o-mini
# P0-11: complex-tier override read by writer/critic via resolveLlmModel.
COMPLEX_MODEL=gpt-4o-mini

OPENAI_BASE_URL=https://api.openai.com/v1

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://jp.cloud.langfuse.com
