{
  "name": "nlquery-infoqaai-backend",
  "version": "0.1.0",
  "description": "InfoQA NL-to-SQL synthesis service: Hono API + LangChain Deep Agents pipeline (isolated subagents, skills, single LLM_MODEL), certified MySQL with Langfuse tracing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contract": "tsx -r dotenv/config tests/integration/contractCheck.ts",
    "eval:queries": "tsx -r dotenv/config tests/integration/query-eval.ts",
    "deep:smoke": "tsx scripts/deep-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/swagger-ui": "^0.6.1",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/openai": "^1.6.0",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "deepagents": "^1.14.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8",
    "langchain": "^1.5.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "nl2sql",
    "hono",
    "typescript",
    "mysql"
  ],
  "author": "",
  "license": "ISC"
}
