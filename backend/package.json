{
  "name": "nlquery-infoqaai-backend",
  "version": "0.1.0",
  "description": "InfoQA NL-to-SQL synthesis service: Hono API + deterministic coordinator over scoped LLM subagents, MySQL-certified queries, Langfuse tracing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contract": "tsx -r dotenv/config evals/contractCheck.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/swagger-ui": "^0.6.1",
    "@langfuse/tracing": "^5.11.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8",
    "langfuse": "^3.39.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "nl2sql",
    "hono",
    "typescript",
    "mysql"
  ],
  "author": "",
  "license": "ISC"
}
